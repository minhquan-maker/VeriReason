# Copy to .env and fill in only the providers you use. Never commit .env.

# Proprietary generator / extractor (backend: anthropic)
ANTHROPIC_API_KEY=

# OpenAI-compatible endpoint (backend: openai_compat) — vLLM, Together, Groq, OpenAI, ...
# For a local vLLM server: OPENAI_BASE_URL=http://localhost:8000/v1 and any non-empty key.
OPENAI_BASE_URL=
OPENAI_API_KEY=
